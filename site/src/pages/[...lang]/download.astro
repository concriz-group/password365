---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { languagePaths, translator } from "../../i18n";
import { download, site } from "../../config";
export const getStaticPaths = languagePaths;
const { tag } = Astro.props;
const t = translator(tag);
const rows = [
  { icon: "work", name: t("download.mac"), text: t("download.macText"), link: download("Password365-macOS.dmg") },
  { icon: "code", name: t("download.windows"), text: "", link: download("Password365-Windows-setup.exe") },
  { icon: "code", name: t("download.linux"), text: "AppImage", link: download("Password365-Linux.AppImage") },
  { icon: "globe", name: t("download.extension"), text: t("download.extensionText"), link: site.stores.chrome ?? download("Password365-extension-Chromium.zip") },
  { icon: "globe", name: t("download.extensionFirefox"), text: t("download.extensionManual"), link: site.stores.firefox ?? download("Password365-extension-Firefox.zip") },
  { icon: "phone", name: t("download.ios"), text: t("download.iosText"), link: site.stores.appStore },
  { icon: "phone", name: t("download.android"), text: t("download.androidText"), link: null, label: t("download.inDevelopment") },
];
---
<Base tag={tag} page="download" title={t("download.title")}>
  <section class="page">
    <div class="wrap">
      <h1>{t("download.title")}</h1>
      <p class="lead">{t("download.lead")}</p>
      <div class="downloads">
        {rows.map((r) => (
          <div class="card download">
            <div style="display:flex;gap:20px;align-items:center">
              <div class="icon" style="margin:0"><Icon name={r.icon} /></div>
              <div><h3 style="margin:0">{r.name}</h3>{r.text && <p style="margin:4px 0 0">{r.text}</p>}</div>
            </div>
            {r.link
              ? <a class="button primary" href={r.link}>{t("nav.download")}</a>
              : <span class="button disabled">{r.label ?? t("download.soon")}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
