---
import Base from "../../layouts/Base.astro";
import { languagePaths, translator } from "../../i18n";
export const getStaticPaths = languagePaths;
const { tag } = Astro.props;
const t = translator(tag);
---
<Base tag={tag} page="pair" title={t("pairPage.title")} description={t("pairPage.lead")} noindex>
  <section class="page">
    <div class="wrap prose center">
      <h1>{t("pairPage.title")}</h1>
      <p class="lead" id="pair-lead">{t("pairPage.lead")}</p>
      <p>
        <a class="button primary" id="pair-open" href="password365://pair" hidden>{t("pairPage.open")}</a>
      </p>
      <p id="pair-none" hidden>{t("pairPage.none")}</p>
      <p>{t("pairPage.noApp")}</p>
      <p class="note">{t("pairPage.how")}</p>
    </div>
  </section>
  <script>
    // The pairing code is in the fragment (#PASSWORD365-PAIR:…): it never reaches a server. The
    // button hands it to the app through its own address, password365://pair#<code>.
    const code = location.hash.slice(1);
    const open = document.getElementById("pair-open") as HTMLAnchorElement;
    if (/^PASSWORD365-PAIR:/i.test(code)) {
      open.href = "password365://pair#" + code;
      open.hidden = false;
    } else {
      document.getElementById("pair-none")!.hidden = false;
      document.getElementById("pair-lead")!.hidden = true;
    }
  </script>
</Base>
