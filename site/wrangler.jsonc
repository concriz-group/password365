// Cloudflare (Workers static assets, the successor of Pages): `npm run deploy`.
{
  "name": "password365",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "password365.app", "custom_domain": true },
    { "pattern": "www.password365.app", "custom_domain": true }
  ]
}
