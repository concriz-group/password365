{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Password365",
  "version": "0.1.0",
  "identifier": "app.password365.desktop",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Password365",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/password365-host"
    ],
    "category": "Utility",
    "shortDescription": "Offline-first password manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NkY0NTlENkE4M0EyQjcKUldTM29vTnFuVVZ2bDZEVXduT0NuTU1BK0hucEgxT2tqOUp2N3J4L3BxQjRWajdCWU4vUytPTXoK",
      "endpoints": [
        "https://github.com/concriz-group/password365/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
